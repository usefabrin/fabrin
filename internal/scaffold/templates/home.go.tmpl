// Package home is a Fabrin module: a self-contained slice of {{ .Name }} that
// owns its own routes.
//
// Add another with `fabrin startapp <name>`, and wire it in main.go.
package home

import (
	"net/http"

	"github.com/usefabrin/fabrin"
)

// Module serves the front page.
type Module struct{}

// New returns the module.
//
// Take dependencies as arguments here rather than reaching for them: a missing
// one then becomes a compile error in main, not a nil dereference on the first
// request.
func New() *Module { return &Module{} }

// Name identifies the module. It is how FABRIN_MODULES selects this module for a
// process, and how a failing readiness check names it — so it is the one string
// here with behaviour attached.
func (m *Module) Name() string { return "home" }

// Routes mounts this module's routes.
func (m *Module) Routes(r fabrin.Router) {
	r.GET("/", func(c *fabrin.Context) {
		c.JSON(http.StatusOK, fabrin.H{"app": "{{ .Name }}"})
	})
}
